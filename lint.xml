<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Disable checks that are too noisy -->
    <issue id="MissingTranslation" severity="warning" />
    <issue id="GoogleAppIndexingWarning" severity="ignore" />

    <!-- Enable strict checks for bugs -->
    <issue id="StopShip" severity="error" />
    <issue id="UnusedResources" severity="warning" />
    <issue id="UnusedDeclaration" severity="warning" />
    <issue id="LogNotTimber" severity="warning" />
    <issue id="RtlEnabled" severity="warning" />
    <issue id="ConvertToWebp" severity="ignore" />

    <!-- Code style -->
    <issue id="SyntheticAccessor" severity="error" />
    <issue id="ObsoleteSdkInt" severity="error" />
    <issue id="VectorRaster" severity="warning" />
    <issue id="IconExpectedSize" severity="ignore" />

    <!-- Performance -->
    <issue id="WakelockTimeout" severity="error" />
    <issue id="Recycle" severity="error" />
    <issue id="DrawAllocation" severity="warning" />
    <issue id="UseSparseArrays" severity="warning" />

    <!-- Security -->
    <issue id="UnprotectedSMSBroadcastReceiver" severity="error" />
    <issue id="ExportedContentProvider" severity="warning" />
    <issue id="PermissionImpliesUnsupportedChromeOs" severity="warning" />
</lint>
